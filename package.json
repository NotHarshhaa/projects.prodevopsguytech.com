{
  "name": "ProDevOpsGuy Tech Projects - Website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "contentlayer2 build",
    "seed": "node data/seed.js",
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "buildvercel": "contentlayer2 build && next build",
    "build": "contentlayer2 build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --fix --dir pages --dir app --dir components --dir lib --dir layouts --dir scripts",
    "prepare": "husky && husky install"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@headlessui/react": "2.2.0",
    "@next/bundle-analyzer": "^16.3.4",
