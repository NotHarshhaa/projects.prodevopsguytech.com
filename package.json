    "cn": "^0.2.5",
    "contentlayer2": "^0.5.8",
    "esbuild": "^0.25.2",
    "framer-motion": "^11.18.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "groq-sdk": "^0.12.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "howler": "^2.2.4",
    "image-size": "1.0.0",
    "lucide-react": "^0.471.1",
    "motion": "^11.18.1",
    "next": "^16.3.4",
    "next-contentlayer2": "^0.5.8",
    "next-themes": "^0.3.0",
    "pliny": "0.4.0",
    "postcss": "^8.4.24",
